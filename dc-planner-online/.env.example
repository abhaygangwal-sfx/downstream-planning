# Copy to .env for local testing (never commit .env).
# Supabase → Project Settings → API (or "API Keys").
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key ONLY. It is safe in the browser because RLS protects the data.
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Never put the service-role / secret key in this project.
